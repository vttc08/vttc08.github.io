{% macro project_card(project, initially_hidden=false) -%}
<x-card
  data-project-card
  data-category="{{ project.category | lower }}"
  data-featured="{{ 'true' if project.featured else 'false' }}"
  {% if initially_hidden %}hidden{% endif %}
>
  <x-carousel slot="media">
    {% for image in project.images|default([]) %}
      <img src="{{ image.url }}" alt="{{ image.alt }}">
    {% endfor %}
  </x-carousel>
  {% set datetext = project.start_date.strftime("%b %Y") if project.start_date.strftime is defined else project.start_date %}
  <time slot="date" datetime="{{ project.start_date }}">
      {{ datetext }}
      {% if project.end_date %}
          - {{ project.end_date.strftime("%b %Y") }}
      {% endif %}
  </time>


  <span slot="category">{{ project.type|title }}</span>
  <h3 slot="title"><a href="{{ project.url }}">{{ project.title }}</a></h3>

  <div slot="description">{{ project.description_html|safe|default(project.description) }}</div>


  {% if project.url %}
    <a slot="link" href="{{ project.url }}">{{ project.read_more|default('View project →') }}</a>
  {% endif %}
</x-card>
{%- endmacro %}