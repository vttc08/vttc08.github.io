<header class="site-header">
  <div class="site-header-elements">
    <a class="site-brand" href="/">&gt; Kevin Hu</a>
    <nav class="site-nav" aria-label="Primary navigation">
      <ul>
        <li>
          <button class="theme-toggle" type="button" aria-label="Change color theme">
            <svg aria-hidden="true" id="theme-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <!-- Sun rays / Moon body -->
              <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </button>
        </li>
        <li>
          <a
            href="/"
            {% if current_page == "home" %}aria-current="page"{% endif %}
          >
            Home
          </a>
        </li>
        <li>
          <a
            href="/resume"
            {% if current_page == "resume" %}aria-current="page"{% endif %}
          >
            Resume
          </a>
        </li>
        <li>
          <a
            href="/posts"
            {% if current_page == "posts" %}aria-current="page"{% endif %}
          >
            Posts
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>